{
  "name": "cf-activity-observatory",
  "version": "1.0.0",
  "private": true,
  "description": "持久化 Cloudflare Security Analytics 与 Security Events 的自托管观测平台",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "deploy": "pnpm build && node ./node_modules/wrangler/bin/wrangler.js deploy",
    "cf-typegen": "node ./node_modules/wrangler/bin/wrangler.js types",
    "cf-typegen:check": "node ./node_modules/wrangler/bin/wrangler.js types --check",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:worker": "node ./node_modules/vitest/vitest.mjs run --config vitest.worker.config.ts",
    "test:all": "pnpm test && pnpm test:worker",
    "pretest:e2e": "pnpm build",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "license:check": "node ./scripts/check-license.mjs",
    "check": "pnpm license:check && pnpm cf-typegen:check && pnpm typecheck && pnpm lint && pnpm test:all && pnpm build",
    "wrangler:dry-run": "node ./node_modules/wrangler/bin/wrangler.js deploy --dry-run",
    "wrangler:startup": "node ./node_modules/wrangler/bin/wrangler.js check startup"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "d3-geo": "^3.1.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "hono": "^4.13.1",
    "iso-3166-1": "^2.1.1",
    "jose": "^6.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.6",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
